### Tenshi compatible keys (fill in real values)
# Claude
CLAUDE_API_KEY=
# Gemini
GEMINI_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# Grok
GROK_API_KEY=
# MagmaRouter（OpenAI 兼容网关，Grok 槽位主路；端点默认 https://api.magmarouter.com/v1，key 形如 sk-mr-...）
# 文档 https://docs.magmarouter.com/welcome/ ；默认模型 glm-5.3-flash-xploded → glm-5.3-xploded（逗号分隔可覆盖）
MAGMAROUTER_API_KEY=
MAGMAROUTER_BASE_URL=https://api.magmarouter.com/v1
MAGMAROUTER_MODELS=glm-5.3-flash-xploded,glm-5.3-xploded
# OpenRouter（已降级为 MagmaRouter 之后的下一级备选）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b
# Web search (preferred)
TAVILY_KEY=

### Server
HOST=127.0.0.1
PORT=8000

### RAG
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

### Web search
WEB_SEARCH_MAX_RESULTS=5

### Models
# One model used as default (UI also allows choosing any supported one)
# Claude: claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5 / claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5
# Gemini: gemini-3.1-pro-preview / gemini-3.8-flash / gemini-3.7-flash / gemini-3.5-flash-lite / gemini-2.5-flash
# Grok: grok-4.7 / grok-4.6 / grok-4.5 / grok-4.3
# MagmaRouter: glm-5.3-flash-xploded / glm-5.3-xploded (依次备选)
# OpenRouter: deepseek/deepseek-r1-distill-llama-70b
DEFAULT_CHAT_MODEL=glm-4.7-flash

### OpenAI-compatible gateway (for GLM trial and any other compatible models)
# Example providers:
# - Glama Gateway: https://glama.ai/api/gateway/openai/v1
# - OpenRouter:   https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

### Trial model (unauthenticated users are forced to use this model)
CALLING_TRIAL_MODEL=glm-4.7-flash

### Global trial quota (shared across everyone)
# Total allowed trial chat requests per hour (best-effort without Redis; exact with Upstash).
CALLING_TRIAL_GLOBAL_PER_HOUR=10

### Optional Claude proxies (same env var names as Tenshi; leave empty to disable)
# Proxy1：同一 CLAUDE_PROXY_BASE_URL 下三档 key
# Fable: Prime→Max→Proxy2→Official；Opus/Sonnet: Base→Prime→Max→Proxy2→Official
# 旧变量 CLAUDE_PROXY_KEY 仍可作为 Base 回退
CLAUDE_PROXY_BASE_URL=
CLAUDE_PROXY_KEY_BASE=
CLAUDE_PROXY_KEY_PRIME=
CLAUDE_PROXY_KEY_MAX=
CLAUDE_PROXY_KEY_2=
CLAUDE_PROXY_BASE_URL_2=

### Auth / Anti-abuse
# Modes: none | apikey | password | github
CALLING_AUTH_MODE=none
CALLING_AUTH_SECRET=

# Optional: allow x-api-key header to bypass session (useful for scripts)
CALLING_API_KEY=

# Password login (if CALLING_AUTH_MODE=password)
CALLING_PASSWORD=

# GitHub OAuth (if CALLING_AUTH_MODE=github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# IMPORTANT: at least one allow-list must be set, otherwise login is denied by default.
GITHUB_ALLOWED_USERS=your_github_login
GITHUB_ALLOWED_ORGS=

### Rate limit
# Per-minute limits. For serverless, in-memory limiter resets on cold start;
# use Upstash below for stable limits.
CALLING_RL_IP_PER_MIN=60
CALLING_RL_USER_PER_MIN=120

# Optional: Upstash Redis (recommended on Vercel when *.upstash.io is reachable)
# Used for rate limits AND conversation sync across serverless instances.
# If DNS/network cannot resolve upstash.io, leave these empty — chat will use data/conversations.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override writable data directory (default: project data/, or /tmp/calling on Vercel)
# CALLING_DATA_DIR=
